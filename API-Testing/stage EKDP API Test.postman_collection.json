			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
							"var json = pm.response.json();",
							"pm.test('Response has result', function () { pm.expect(json).to.have.property('result'); });",
							"if (json.result === 'SUCCESS') {",
							"    pm.environment.set('import_id', json.data.toString());",
							"    console.log('Saved import_id = ' + json.data);",
							"} else {",
